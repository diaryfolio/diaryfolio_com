---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const byYear = posts.reduce<Record<string, typeof posts>>((years, post) => {
  const year = post.data.date.slice(0, 4);
  (years[year] ??= []).push(post);
  return years;
}, {});
---

<BaseLayout title="Archive">
  <section class="intro"><p class="eyebrow">All articles</p><h1>Archive</h1></section>
  {Object.entries(byYear).sort(([a], [b]) => b.localeCompare(a)).map(([year, entries]) => (
    <section class="archive-year">
      <h2>{year}</h2>
      <ul>
        {entries.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date)).map((post) => (
          <li><time datetime={post.data.date}>{post.data.date.slice(5, 10)}</time> <a href={post.data.legacy_url}>{post.data.title}</a></li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
