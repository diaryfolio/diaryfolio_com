---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));
const labelCounts = posts.flatMap((post) => post.data.labels).reduce<Record<string, number>>((counts, label) => {
  counts[label] = (counts[label] ?? 0) + 1;
  return counts;
}, {});
const labels = Object.entries(labelCounts)
  .sort(([labelA, countA], [labelB, countB]) => countB - countA || labelA.localeCompare(labelB))
  .slice(0, 30)
  .map(([label]) => label);
---

<BaseLayout title="Search" description="Search the complete DiaryFolio technical archive.">
  <section class="search-hero">
    <p class="eyebrow">Complete archive</p>
    <h1>Search the notes</h1>
    <label class="search-box" for="archive-search">
      <span aria-hidden="true">⌕</span>
      <input id="archive-search" type="search" placeholder="Search articles, topics, or commands…" autocomplete="off" />
    </label>
    <div class="filter-row">
      <label class="select-label" for="tag-filter">Filter by popular topic
        <select id="tag-filter">
          <option value="">All topics</option>
          {labels.map((label) => <option value={label}>{label} ({labelCounts[label]})</option>)}
        </select>
      </label>
    </div>
    <p id="result-count" class="result-count">Loading {posts.length} articles…</p>
  </section>
  <section id="search-results" class="search-results" aria-live="polite" aria-busy="true"></section>

  <script>
    const input = document.querySelector('#archive-search');
    const results = document.querySelector('#search-results');
    const count = document.querySelector('#result-count');
    const tagFilter = document.querySelector('#tag-filter');

    if (input instanceof HTMLInputElement && results instanceof HTMLElement && count instanceof HTMLElement && tagFilter instanceof HTMLSelectElement) {
      let activeTag = '';
      let searchData = [];
      const params = new URLSearchParams(window.location.search);
      input.value = params.get('q') || '';

      const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char] ?? char));
      const dateLabel = (value) => new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

      function render() {
        const query = input.value.trim().toLowerCase();
        const found = searchData.filter((post) => {
          const haystack = `${post.title} ${post.description} ${post.text} ${post.labels.join(' ')}`.toLowerCase();
          return (!query || haystack.includes(query)) && (!activeTag || post.labels.includes(activeTag));
        });
        const visible = query || activeTag ? found : found.slice(0, 24);
        count.textContent = query || activeTag
          ? `${found.length} article${found.length === 1 ? '' : 's'} found`
          : `Showing 24 newest of ${found.length} articles`;
        results.innerHTML = visible.length
          ? visible.map((post) => {
              const visibleLabels = post.labels.slice(0, 4);
              const hiddenLabels = post.labels.length - visibleLabels.length;
              const tags = visibleLabels.map((label) => `<span>${escapeHtml(label)}</span>`).join('');
              const more = hiddenLabels > 0 ? `<span class="tag-more">+${hiddenLabels}</span>` : '';
              return `<article class="result-card"><p class="eyebrow">${dateLabel(post.date)}</p><h2><a href="${escapeHtml(post.url)}">${escapeHtml(post.title)}</a></h2>${post.description ? `<p>${escapeHtml(post.description)}</p>` : ''}<p class="tags">${tags}${more}</p></article>`;
            }).join('')
          : '<p class="empty-result">No articles matched that search. Try a broader phrase or another topic.</p>';
        results.setAttribute('aria-busy', 'false');
      }

      fetch('/search-index.json')
        .then((response) => {
          if (!response.ok) throw new Error(`Search index returned ${response.status}`);
          return response.json();
        })
        .then((data) => { searchData = data; render(); })
        .catch(() => {
          count.textContent = 'Search is temporarily unavailable.';
          results.innerHTML = '<p class="empty-result">The search index could not be loaded. You can still browse the <a href="/archive.html">complete archive</a>.</p>';
          results.setAttribute('aria-busy', 'false');
        });

      input.addEventListener('input', () => {
        const url = new URL(window.location.href);
        input.value ? url.searchParams.set('q', input.value) : url.searchParams.delete('q');
        history.replaceState({}, '', url);
        render();
      });
      tagFilter.addEventListener('change', () => { activeTag = tagFilter.value; render(); });
    }
  </script>
</BaseLayout>
