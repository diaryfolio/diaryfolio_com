---
import '../styles/site.css';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const {
  title = 'DiaryFolio',
  description = 'Practical notes on systems, software, data, and technology.',
  type = 'website',
  structuredData
} = Astro.props;
const pageTitle = title === 'DiaryFolio' ? title : `${title} · DiaryFolio`;
const siteUrl = Astro.site ?? new URL('https://diaryfolio.com');
const canonical = new URL(Astro.url.pathname, siteUrl);
const currentPath = Astro.url.pathname;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true' && Boolean(adsenseClient);
const googleAnalyticsId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const navItems = [
  { href: '/', label: 'Articles' },
  { href: '/archive.html', label: 'Archive' },
  { href: '/search.html', label: 'Search' }
];
const isCurrent = (href: string) => href === '/'
  ? !['/archive.html', '/search.html', '/privacy.html'].includes(currentPath)
  : currentPath === href;
const siteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DiaryFolio',
  url: new URL('/', siteUrl).href,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${new URL('/search.html', siteUrl).href}?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('diaryfolio-theme');
        if (savedTheme === 'dark' || (!savedTheme && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f7f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10171c" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="DiaryFolio" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="DiaryFolio RSS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(siteStructuredData)}></script>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
    {adsEnabled && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="DiaryFolio home"><span class="brand-mark" aria-hidden="true">D</span><span>DiaryFolio</span></a>
        <nav aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" title="Toggle colour theme">◐</button>
        </nav>
      </div>
    </header>
    <main id="main-content" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell site-footer-inner">
        <span>DiaryFolio · Technical notes since 2008</span>
        <span class="footer-links">
          <a href="/privacy.html">Privacy and cookies</a>
          {googleAnalyticsId && <button type="button" id="cookie-settings" aria-controls="analytics-consent">Cookie settings</button>}
        </span>
      </div>
    </footer>
    <ConsentBanner googleAnalyticsId={googleAnalyticsId} />
    <script is:inline>
      const themeToggle = document.querySelector('#theme-toggle');
      const setTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('diaryfolio-theme', theme); } catch {}
        themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'));
      };
      themeToggle?.addEventListener('click', () => setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));
      themeToggle?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
    </script>
  </body>
</html>
